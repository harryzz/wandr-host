#!/bin/sh
# wandr — desktop app manager for the wandr runtime (Linux & macOS).
#
#   wandr list                 apps in the registry  (● = installed)
#   wandr install <id> [ver]   download + install an app from the registry
#   wandr run <id>             run an installed app
#   wandr remove <id> [ver]    uninstall an app (all versions, or one)
#   wandr installed            list installed apps
#   wandr help
#
# Env:
#   WANDR_HOME      runtime home            (default: ~/.wandr)
#   WANDR_REGISTRY  index.json URL or path  (default: the builtin registry)
#
# Installs the runtime host with install.sh first. Windows: use wandr.ps1.
set -eu

WANDR_HOME="${WANDR_HOME:-$HOME/.wandr}"
BIN_DIR="$WANDR_HOME/bin"
HOST="$BIN_DIR/wandr-host"
# The host writes/reads installed apps at <WANDR_APPS_ROOT>/apps/<id>/<version>,
# so rooting it at WANDR_HOME puts them under ~/.wandr/apps alongside ~/.wandr/bin.
APPS_ROOT="$WANDR_HOME"
INSTALLED_DIR="$APPS_ROOT/apps"
REGISTRY="${WANDR_REGISTRY:-https://harryzz.github.io/wandr-apps/index.json}"

info() { printf '\033[1;32m▸\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }

need_host() { [ -x "$HOST" ] || err "wandr-host not found at $HOST — run install.sh first."; }

# fetch <url-or-path> → stdout
fetch() {
  case "$1" in
    file://*)     cat "${1#file://}" ;;
    /*|./*|../*)  cat "$1" ;;
    *) if   command -v curl >/dev/null 2>&1; then curl -fsSL "$1"
       elif command -v wget >/dev/null 2>&1; then wget -qO- "$1"
       else err "need curl or wget to reach the registry."; fi ;;
  esac
}
# download <url-or-path> <out>
download() {
  case "$1" in
    file://*)     cp "${1#file://}" "$2" ;;
    /*|./*|../*)  cp "$1" "$2" ;;
    *) if   command -v curl >/dev/null 2>&1; then curl -fSL --progress-bar "$1" -o "$2"
       elif command -v wget >/dev/null 2>&1; then wget -q --show-progress -O "$2" "$1"
       else err "need curl or wget."; fi ;;
  esac
}

# --- JSON: prefer jq, fall back to python3 (registry commands only) ----------
_json_engine=""
json_engine() {
  [ -n "$_json_engine" ] && { printf '%s' "$_json_engine"; return; }
  if   command -v jq      >/dev/null 2>&1; then _json_engine=jq
  elif command -v python3 >/dev/null 2>&1; then _json_engine=py
  else err "the registry commands (list/install) need 'jq' or 'python3' installed."; fi
  printf '%s' "$_json_engine"
}
# field <json> <id> <field> → value (empty if absent)
json_field() {
  case "$(json_engine)" in
    jq) printf '%s' "$1" | jq -r --arg id "$2" --arg f "$3" \
          '.apps[]|select(.id==$id)|.[$f]//empty' ;;
    py) printf '%s' "$1" | python3 -c 'import sys,json
d=json.load(sys.stdin); i,f=sys.argv[1],sys.argv[2]
print(next((str(a.get(f,"")) for a in d.get("apps",[]) if a.get("id")==i),""))' "$2" "$3" ;;
  esac
}
# rows <json> → "id<TAB>version<TAB>name" per app
json_rows() {
  case "$(json_engine)" in
    jq) printf '%s' "$1" | jq -r '.apps[]|[.id,(.version//"?"),(.name//"")]|@tsv' ;;
    py) printf '%s' "$1" | python3 -c 'import sys,json
for a in json.load(sys.stdin).get("apps",[]):
    print("\t".join([a.get("id",""),str(a.get("version","?")),a.get("name","")]))' ;;
  esac
}

sha256_of() {
  if   command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  elif command -v shasum    >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
  else printf ''; fi
}

# --- commands ----------------------------------------------------------------
cmd_list() {
  case "${1:-}" in --installed|-i) cmd_installed; return ;; esac
  idx="$(fetch "$REGISTRY")" || err "cannot read registry: $REGISTRY"
  printf '%s\n' "registry: $REGISTRY"
  json_rows "$idx" | while IFS="$(printf '\t')" read -r id ver name; do
    [ -n "$id" ] || continue
    if [ -d "$INSTALLED_DIR/$id" ]; then mark="●"; else mark=" "; fi
    printf '  %s %-28s %-8s %s\n' "$mark" "$id" "$ver" "$name"
  done
  printf '\n● = installed. Install:  wandr install <id>\n'
}

cmd_installed() {
  [ -d "$INSTALLED_DIR" ] || { info "no apps installed."; return; }
  found=0
  for iddir in "$INSTALLED_DIR"/*/; do
    [ -d "$iddir" ] || continue
    id="$(basename "$iddir")"
    for verdir in "$iddir"*/; do
      [ -f "$verdir/package.toml" ] || continue
      ver="$(basename "$verdir")"
      printf '  %-28s %s\n' "$id" "$ver"
      found=1
    done
  done
  [ "$found" = 1 ] || info "no apps installed."
}

cmd_install() {
  [ $# -ge 1 ] || err "usage: wandr install <id> [version]"
  need_host
  id="$1"; want_ver="${2:-}"
  idx="$(fetch "$REGISTRY")" || err "cannot read registry: $REGISTRY"
  url="$(json_field "$idx" "$id" url)"
  ver="$(json_field "$idx" "$id" version)"
  sha="$(json_field "$idx" "$id" sha256)"
  [ -n "$url" ] || err "'$id' not found in the registry ($REGISTRY)."
  [ -z "$want_ver" ] || [ "$want_ver" = "$ver" ] || \
    warn "registry has $id v$ver (requested v$want_ver) — installing v$ver."

  tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
  info "downloading $id v$ver …"
  download "$url" "$tmp" || err "download failed: $url"
  if [ -n "$sha" ]; then
    got="$(sha256_of "$tmp")"
    [ -z "$got" ] || [ "$got" = "$sha" ] || err "checksum mismatch for $id (want $sha, got $got)."
    [ -z "$got" ] || info "checksum ok."
  fi
  info "installing …"
  WANDR_APPS_ROOT="$APPS_ROOT" "$HOST" --install "$tmp" || err "install failed."
  info "installed $id v$ver → $INSTALLED_DIR/$id/$ver"
  printf 'run it with:  wandr run %s\n' "$id"
}

cmd_run() {
  [ $# -ge 1 ] || err "usage: wandr run <id>"
  need_host
  id="$1"
  [ -d "$INSTALLED_DIR/$id" ] || err "$id is not installed — try: wandr install $id"
  exec env WANDR_APPS_ROOT="$APPS_ROOT" "$HOST" --app "$id"
}

cmd_remove() {
  [ $# -ge 1 ] || err "usage: wandr remove <id> [version]"
  id="$1"; ver="${2:-}"
  target="$INSTALLED_DIR/$id"
  [ -z "$ver" ] || target="$INSTALLED_DIR/$id/$ver"
  [ -e "$target" ] || err "$id${ver:+ v$ver} is not installed."
  rm -rf "$target"
  # prune an empty <id>/ dir left after removing a single version
  [ -z "$ver" ] || rmdir "$INSTALLED_DIR/$id" 2>/dev/null || true
  info "removed $id${ver:+ v$ver}."
}

usage() {
  cat <<'EOF'
wandr — desktop app manager for the wandr runtime.

  wandr list                 apps in the registry  (● = installed)
  wandr list --installed     installed apps only
  wandr install <id> [ver]   download + install an app from the registry
  wandr run <id>             run an installed app
  wandr remove <id> [ver]    uninstall an app (all versions, or one)
  wandr installed            list installed apps
  wandr help

Env: WANDR_HOME (default ~/.wandr), WANDR_REGISTRY (index.json URL or path)
EOF
}

case "${1:-help}" in
  list)              shift; cmd_list "$@" ;;
  install|add)       shift; cmd_install "$@" ;;
  run|launch)        shift; cmd_run "$@" ;;
  remove|rm|uninstall) shift; cmd_remove "$@" ;;
  installed|ls)      shift; cmd_installed "$@" ;;
  help|-h|--help)    usage ;;
  *) warn "unknown command: $1"; usage; exit 1 ;;
esac
